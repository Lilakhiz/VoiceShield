# VoiceGuard - Production Environment Configuration
# Copy this file to .env and customize for your deployment
# 
# SECURITY: Never commit the actual .env file to version control!

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Set to 'false' in production
DEMO_MODE=true

# Logging
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON=false                    # true for JSON logs in production
LOG_FILE=/app/logs/voiceguard.log # Optional: file path for log rotation

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Generate with: openssl rand -hex 32
# CRITICAL: Change this in production!
JWT_SECRET_KEY=dev-secret-change-in-production

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Speaker verification threshold (cosine similarity 0-1)
SPEAKER_VERIFICATION_THRESHOLD=0.5

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (development): sqlite:///./data/voiceguard.db
# PostgreSQL (production): postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/voiceguard.db

# ============================================================================
# CORS & NETWORK
# ============================================================================
# Comma-separated list of allowed origins
# Production example: https://voiceguard.example.com,https://app.example.com
CORS_ORIGINS=*

# WebSocket base URL (for frontend)
VITE_WS_BASE=ws://localhost:8000

# API base URL (for frontend)
VITE_API_BASE=http://localhost:8000

# ============================================================================
# REDIS (for distributed state - optional)
# ============================================================================
# Set to 'true' to enable Redis for distributed rate limiting, locks, etc.
USE_REDIS=false
REDIS_URL=redis://redis:6379/0

# ============================================================================
# ML MODEL SETTINGS
# ============================================================================
# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=small

# Deepfake model path (optional - for pretrained AASIST/RawNet2)
DEEPFAKE_MODEL_PATH=

# ============================================================================
# RATE LIMITING
# ============================================================================
# Requests per window
RATE_LIMIT_API=60          # requests per minute for general API
RATE_LIMIT_AUTH=10         # requests per minute for auth endpoints
RATE_LIMIT_ENROLL=5        # requests per minute for enrollment

# ============================================================================
# RISK ENGINE THRESHOLDS
# ============================================================================
# Risk score thresholds (0-100)
RISK_HIGH_THRESHOLD=55
RISK_CRITICAL_THRESHOLD=80
RISK_SUGGEST_VERIFICATION=60

# EMA smoothing factor (0-1)
RISK_EMA_ALPHA=0.55

# Trust recovery cap per snapshot
RISK_TRUST_RECOVERY_CAP=6

# ============================================================================
# DEEPFAKE DETECTOR HEURISTICS (baseline values - NOT CALIBRATED)
# ============================================================================
DEEPFAKE_JITTER_WEIGHT=150.0
DEEPFAKE_JITTER_BASELINE=0.01
DEEPFAKE_HNR_WEIGHT=0.8
DEEPFAKE_HNR_BASELINE=1.5
DEEPFAKE_FLATNESS_WEIGHT=-2.0
DEEPFAKE_FLATNESS_BASELINE=0.25

# ============================================================================
# REPLAY DETECTOR HEURISTICS (baseline values - NOT CALIBRATED)
# ============================================================================
REPLAY_HF_RATIO_WEIGHT=6.0
REPLAY_HF_RATIO_BASELINE=0.12
REPLAY_ROLLOFF_WEIGHT=3.0
REPLAY_ROLLOFF_BASELINE=0.35
REPLAY_CENTROID_VAR_WEIGHT=-75.0

# ============================================================================
# VAD SETTINGS
# ============================================================================
VAD_ENERGY_THRESHOLD=0.005
VAD_SPECTRAL_FLATNESS_THRESHOLD=0.5
VAD_MIN_SPEECH_SECONDS=0.5
VAD_MAX_SILENCE_FRAMES=15

# ============================================================================
# AUDIO PROCESSING
# ============================================================================
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1600

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WS_MAX_MESSAGE_SIZE=1048576
WS_AUDIO_QUEUE_MAX_SIZE=50
WS_BUFFERED_AMOUNT_THRESHOLD=65536

# ============================================================================
# DEEPFAKE MODEL PATH (for pretrained checkpoint)
# ============================================================================
# DEEPFAKE_MODEL_PATH=/app/models/aasist.pth